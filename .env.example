# ==============================================================================
# Apeiron Solutions — Environment Configuration Template (.env.example)
# Copy this file to .env and adjust values for your environment.
# Never commit your real .env file with secrets to version control.
# ==============================================================================

# Server Runtime & Ports
NODE_ENV=development
PORT=8080
ADMIN_PORT=8081
ADMIN_HOST=127.0.0.1

# Staff Administration
# The first time the server starts, it will bootstrap this admin account if it does
# not yet exist. Once bootstrapped, REMOVE or clear ADMIN_PASSWORD from .env.
ADMIN_EMAIL=apeironsolvs@gmail.com
ADMIN_PASSWORD=your-secure-admin-password-12+chars
ADMIN_NOTIFY_EMAIL=apeironsolvs@gmail.com

# Staff Security & Network Access Control
# Optional: comma-separated list of allowed client IP addresses for the admin portal.
# In production, if ADMIN_HOST is not 127.0.0.1, set this to your staff IPs.
# ADMIN_ALLOWED_IPS=127.0.0.1,::1

# Database Backend Configuration
# Options: 'sqlite' (local file storage) or 'supabase' (Cloud PostgreSQL)
DATABASE_BACKEND=sqlite
DATA_DIR=data

# Supabase Cloud Database (Required if DATABASE_BACKEND=supabase)
# SUPABASE_URL=https://your-project-id.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key
# SUPABASE_ANON_KEY=your-supabase-anon-key

# Email Configuration (for password reset codes and staff notification alerts)
# Option 1: Direct SMTP over TLS (e.g. Gmail with an App Password)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=apeironsolvs@gmail.com
# SMTP_PASS=your-google-app-password
# SMTP_SECURE=1
# MAIL_FROM=Apeiron Solutions <apeironsolvs@gmail.com>

# Option 2: Resend API (Alternative HTTP provider)
# RESEND_API_KEY=re_your_api_key_here
# MAIL_API_URL=https://api.resend.com/emails

# Hosting, Proxy & Keep-Alive
# Set TRUST_PROXY=1 when deployed behind reverse proxies (Render, Railway, Cloudflare, etc.)
# TRUST_PROXY=1
# ALLOWED_ORIGIN=https://YOUR-DOMAIN.com
# SINGLE_PORT=1
# KEEP_ALIVE=1
# KEEP_ALIVE_URL=https://your-app.onrender.com

# Data Retention & Backups
RETENTION_DAYS=365
BACKUP_KEEP=14
