{
  "version": 2,
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.js" },
    { "source": "/admin", "destination": "/admin-site/index.html" },
    { "source": "/admin/", "destination": "/admin-site/index.html" },
    { "source": "/admin/(.*)", "destination": "/admin-site/$1" },
    { "source": "/", "destination": "/site/index.html" },
    { "source": "/account", "destination": "/site/account/index.html" },
    { "source": "/account/", "destination": "/site/account/index.html" },
    { "source": "/start", "destination": "/site/start/index.html" },
    { "source": "/start/", "destination": "/site/start/index.html" },
    { "source": "/terms", "destination": "/site/terms.html" },
    { "source": "/privacy", "destination": "/site/privacy.html" },
    { "source": "/security", "destination": "/site/security.html" },
    { "source": "/(.*)", "destination": "/site/$1" }
  ]
}
