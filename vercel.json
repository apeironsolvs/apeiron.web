{
  "version": 2,
  "outputDirectory": "public",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.js" },
    { "source": "/admin", "destination": "/admin/index.html" },
    { "source": "/account", "destination": "/account/index.html" },
    { "source": "/start", "destination": "/start/index.html" }
  ]
}
